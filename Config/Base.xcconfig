// Base.xcconfig
// Dictari — tracked build defaults shared by every target (wired in project.yml `configFiles`).
//
// Code signing defaults to ad-hoc ("-") so a fresh clone builds without anyone's certificate.
// To sign with your own identity, copy Local.xcconfig.example to Local.xcconfig (untracked)
// at the repository root and set DICTARI_SIGN_IDENTITY there. Keeping one identity across
// rebuilds matters: macOS keys the Accessibility and Microphone grants on it.

DICTARI_SIGN_IDENTITY = -

// Hardened runtime only with a real identity. Under it, library validation makes dyld refuse
// Xcode's ad-hoc signed Dictari.debug.dylib ("different Team IDs") and a Debug build won't start.
// release.sh and build-run.sh sign with --options runtime themselves, so releases keep it.
DICTARI_HARDENED_RUNTIME = NO
DICTARI_CODE_SIGN_FLAGS =

#include? "../Local.xcconfig"
