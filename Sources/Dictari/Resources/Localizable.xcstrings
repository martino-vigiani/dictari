    "%@ Try again." : {
      "comment" : "Model preparation failure; the argument is the underlying error message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Riprova."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Спробуйте ще раз."
          }
        }
      }
    },
    "%@ Waiting for the model to stop. If it remains stuck, quit and reopen Dictari, then resume the saved audio." : {
      "comment" : "The argument is the previous message (why processing stopped)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Warte, bis das Modell stoppt. Hängt es weiter, beende Dictari, öffne es erneut und setze die gesicherte Aufnahme fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Esperando a que el modelo se detenga. Si sigue bloqueado, cierra y vuelve a abrir Dictari y reanuda el audio guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Attente de l’arrêt du modèle. S’il reste bloqué, quittez et rouvrez Dictari, puis reprenez l’audio enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ In attesa che il modello si fermi. Se resta bloccato, esci e riapri Dictari, poi riprendi l’audio salvato."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Aguardando o modelo parar. Se continuar travado, encerre e reabra o Dictari e retome o áudio salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ожидание остановки модели. Если зависание не пройдёт, завершите и снова откройте Dictari, затем продолжите обработку сохранённого аудио."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Очікування зупинки моделі. Якщо вона не відповідає, закрийте й знову відкрийте Dictari, а потім продовжте збережене аудіо."
          }
        }
      }
    },
