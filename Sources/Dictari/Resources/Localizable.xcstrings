    "%@ will be deleted. If active, Default is used next. Saved transcripts remain." : {
      "comment" : "Delete-profile alert; %@ is the profile name, Default the built-in profile",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird gelöscht. War es aktiv, wird danach „Standard“ verwendet. Gesicherte Transkripte bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará %@. Si está activo, se usará Predeterminado. Las transcripciones guardadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimé. S’il est actif, le profil Par défaut sera utilisé. Les transcriptions enregistrées sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà eliminato. Se è attivo, al suo posto verrà usato Predefinito. Le trascrizioni salvate restano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será apagado. Se estiver ativo, o perfil Padrão será usado. As transcrições salvas permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль «%@» будет удалён. Если он активен, будет использоваться профиль «По умолчанию». Сохранённые расшифровки останутся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профіль «%@» буде видалено. Якщо він активний, далі використовуватиметься «Стандартний». Збережені розшифровки залишаться."
          }
        }
      }
    },
