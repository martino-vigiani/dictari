    "%lld vocabulary entries, %lld custom profiles, %lld profile languages and %lld app rules. Duplicates merge; existing settings win." : {
      "comment" : "Import confirmation; every number needs plural forms",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vokabular: %1$lld, eigene Profile: %2$lld, Profilsprachen: %3$lld, App-Regeln: %4$lld. Duplikate werden zusammengeführt, deine bestehenden Einstellungen haben Vorrang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld vocabulary entries, %2$lld custom profiles, %3$lld profile languages and %4$lld app rules. Duplicates merge; existing settings win."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld entradas de vocabulario, %2$lld perfiles personalizados, %3$lld idiomas de perfil y %4$lld reglas de apps. Los duplicados se combinan; prevalecen tus ajustes actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrées de vocabulaire : %1$lld, profils personnalisés : %2$lld, langues de profil : %3$lld, règles d’app : %4$lld. Les doublons sont fusionnés ; vos réglages existants sont prioritaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voci del vocabolario: %1$lld. Profili personalizzati: %2$lld. Lingue dei profili: %3$lld. Regole per app: %4$lld. I duplicati vengono uniti; le impostazioni esistenti hanno la precedenza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entradas de vocabulário: %1$lld; perfis personalizados: %2$lld; idiomas de perfil: %3$lld; regras de app: %4$lld. Duplicatas são mescladas; os ajustes existentes prevalecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи словаря: %1$lld, свои профили: %2$lld, языки профилей: %3$lld, правила для приложений: %4$lld. Дубликаты объединяются, текущие настройки сохраняются."
