    "Edits before inserting, with no preview. Failures keep the original in History." : {
      "comment" : "Writing app rule: Automatic",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitet vor dem Einfügen, ohne Vorschau. Bei Fehlern bleibt das Original im Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita antes de insertar, sin vista previa. Si falla, el original se conserva en el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige avant l’insertion, sans aperçu. En cas d’échec, l’original reste dans l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
