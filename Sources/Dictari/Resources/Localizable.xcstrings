    "Hold the keys while you speak, let go to finish" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Tasten beim Sprechen gedrückt, lass los zum Beenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas las teclas mientras hablas y suéltalas para terminar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez les touches pendant que vous parlez, relâchez pour terminer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuti i tasti mentre parli, rilascia per terminare"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure as teclas enquanto fala e solte para terminar"
          }
