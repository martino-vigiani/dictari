    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description: shown by macOS when Dictari asks for the microphone",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dictari transcribes your voice entirely on this Mac. Audio never leaves your device."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictari trascrive la tua voce interamente su questo Mac. L’audio non esce mai dal dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictari transkribiert deine Stimme vollständig auf diesem Mac. Audio verlässt dein Gerät nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictari transcrit votre voix entièrement sur ce Mac. L’audio ne quitte jamais votre appareil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictari transcribe tu voz íntegramente en este Mac. El audio nunca sale de tu dispositivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dictari transcreve sua voz inteiramente neste Mac. O áudio nunca sai do seu dispositivo."
